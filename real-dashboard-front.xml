        <DialogHeader>
          <DialogTitle>{isEditing ? 'Editar Accesorio' : 'Nuevo Accesorio'}</DialogTitle>
          <DialogDescription>
            {isEditing ? 'Modificá los datos del accesorio.' : 'Completá los datos para crear un nuevo accesorio de marca.'}
