}

export interface PaginatedMensajes {
  items: Mensaje[];
  meta: PaginationMeta;
}

export interface ConversacionFilters {
  canal?: Canal;
  etapa?: EtapaCliente;
  search?: string;
  page?: number;
  limit?: number;
}

export interface EnviarMensajeInput {
